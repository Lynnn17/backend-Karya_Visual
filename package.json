{
  "name": "karya-visual",
  "description": "Karya Visual API",
  "type": "module",
  "version": "1.0.0",
  "main": "app.js",
  "license": "MIT",
  "author": {
    "name": "Aryeswara Lintang Eka Kusuma",
    "url": "https://www.linkedin.com/in/aryeswara-lintang-eka-kusuma-a464a717a/"
  },
  "scripts": {
    "dev": "nodemon src/app.js",
    "migrate": "npx sequelize-cli db:migrate --config src/config/config.js --migrations-path src/migrations --models-path src/models --seeders-path src/seeders",
    "seed": "npx sequelize-cli db:seed:all --config src/config/config.js --migrations-path src/migrations --models-path src/models --seeders-path src/seeders",
    "make:migration": "npx sequelize-cli migration:generate --config src/config/config.js --migrations-path src/migrations --name",
    "make:seeder": "npx sequelize-cli seed:generate --config src/config/config.js --seeders-path src/seeders --name"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.4.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nanoid": "^5.0.9",
    "nodemon": "^3.1.7",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
